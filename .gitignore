!/GVHMR/hmr4d/utils/body_model/smplx_verts437.pt
!/GVHMR/hmr4d/utils/body_model/smpl_3dpw14_J_regressor_sparse.pt
!/GVHMR/hmr4d/utils/body_model/smpl_coco17_J_regressor.pt
!/GVHMR/hmr4d/utils/body_model/smpl_neutral_J_regressor.pt
!/GVHMR/hmr4d/network/hmr2/configs/smpl_mean_params.npz
!/GVHMR/hmr4d/dataset/bedlam/resource/vname2lwh.pt
!/GVHMR/hmr4d/dataset/rich/resource/cam2params.pt

