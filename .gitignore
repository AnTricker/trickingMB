# ==========================================
# Input Videos / Data
# ==========================================
# Match data folders at any depth, but keep directory placeholders.
**/input/*
!**/input/.gitkeep
**/inputs/*
!**/inputs/.gitkeep

# MotionAGFormer demo inputs; retain the upstream sample video.
/MotionAGFormer/demo/video/*
!/MotionAGFormer/demo/video/.gitkeep
!/MotionAGFormer/demo/video/sample_video.mp4

# ==========================================
# Inference Results
# ==========================================
**/output/*
!**/output/.gitkeep
**/outputs/*
!**/outputs/.gitkeep
**/output-*/*
!**/output-*/.gitkeep

# ==========================================
# Generated Data / Intermediate Files
# ==========================================
*.npy
*.npz
*.pkl
*.pickle

# GVHMR ships these small runtime resources with its source code.
# They are regressors, mappings and metadata, not downloaded checkpoints.
